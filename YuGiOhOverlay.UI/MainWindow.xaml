<Window x:Class="YuGiOhOverlay.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duel Companion · Configuration" Width="900" Height="860" MinWidth="720" MinHeight="560"
        Background="#0B111C" Foreground="#F0F5FC" WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32">
            <TextBlock Text="DUEL COMPANION" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold" />
            <TextBlock Text="Ta main. Le bon point de départ." FontSize="28" FontWeight="SemiBold" Margin="0,8,0,6" />
            <TextBlock Text="Connecte un deck, cadre la main, puis laisse l’overlay repérer les combos compatibles."
                       Style="{StaticResource Caption}" Margin="0,0,0,24" />
            <StackPanel x:Name="ConfigurationPanel">
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="01   Choisir les combos" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Lien Combos &amp; Counters de Master Duel Meta" Style="{StaticResource Caption}" Margin="0,10,0,5" />
                        <TextBox x:Name="SourceUrl" AutomationProperties.Name="Lien du deck Master Duel Meta" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Synchroniser le deck" Style="{StaticResource Primary}" Click="Sync_Click" />
                            <Button Content="Importer un catalogue JSON" Click="Import_Click" />
                            <Button Content="Mes anciennes fiches" Click="Legacy_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="CatalogStatus" Style="{StaticResource Caption}" Margin="0,12,0,0" Text="Aucun catalogue chargé." />
                        <Expander x:Name="WarningsExpander" Header="Détails de l’import" Foreground="#D0DFED" Margin="0,8,0,0">
                            <TextBox x:Name="ImportWarnings" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto" />
                        </Expander>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="02   Cadrer la main" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Choisis la fenêtre du jeu, puis trace un rectangle autour de toute ta main, illustrations comprises."
                                   Style="{StaticResource Caption}" Margin="0,8,0,12" />
                        <DockPanel>
                            <Button Content="Actualiser" DockPanel.Dock="Right" Click="Refresh_Click" Margin="8,0,0,0" />
                            <ComboBox x:Name="TargetCombo" MinHeight="34" AutomationProperties.Name="Fenêtre du jeu" />
                        </DockPanel>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Calibrer la zone de main" Click="Calibrate_Click" />
                            <TextBlock x:Name="CalibrationStatus" Text="Calibration requise" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                        </WrapPanel>
                        <WrapPanel Margin="0,4,0,8">
                            <Button Content="Calibrer mon terrain" Click="CalibrateField_Click" />
                            <TextBlock x:Name="FieldCalibrationStatus" Text="Terrain non calibré" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                        </WrapPanel>
                        <TextBlock Text="Facultatif : cadre uniquement ton terrain, hors main et terrain adverse, pour suivre les invocations. Les autres étapes restent validables à la main." Style="{StaticResource Caption}" />
                        <CheckBox x:Name="DiagnosticsCheck" Content="Afficher le diagnostic en mémoire (aucune capture enregistrée)" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <Border Style="{StaticResource Panel}" BorderBrush="#315C59">
                <StackPanel>
                    <TextBlock Text="03   Observer le duel" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Les suggestions vérifient les cartes de départ. Tu gardes la main sur les choix, les étapes et les conditions du terrain."
                               Style="{StaticResource Caption}" Margin="0,8,0,14" />
                    <WrapPanel>
                        <Button x:Name="StartButton" Content="Lancer l’observation" Style="{StaticResource Primary}" Click="Start_Click" />
                        <Button x:Name="StopButton" Content="Suspendre" IsEnabled="False" Click="Stop_Click" />
                        <Button x:Name="DemoButton" Content="Essayer la démo" Click="Demo_Click" />
                        <Button Content="Voir l’overlay" Click="Overlay_Click" />
                    </WrapPanel>
                    <TextBlock Text="Ctrl+F1 : interagir avec l’overlay · Ctrl+F2 : suspendre · Ctrl+→ / Ctrl+← : étapes du guide"
                               Style="{StaticResource Caption}" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="Message" Text="Prêt à configurer · mode Observation uniquement" Foreground="{StaticResource Accent}" />
            <TextBlock Text="{Binding Status}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding Timing}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            <Border Background="#111A28" CornerRadius="8" Margin="0,12,0,0" Padding="8">
                <StackPanel>
                    <Image x:Name="DiagnosticPreview" Source="{Binding DiagnosticImage}" Stretch="Uniform" MaxHeight="240" />
                    <ItemsControl ItemsSource="{Binding Hand}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <TextBlock Foreground="#D0DFED"><Run Text="{Binding Name}" /><Run Text=" · " /><Run Text="{Binding Confidence}" /></TextBlock>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
