<Window x:Class="YuGiOhOverlay.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duel Companion · Overlay" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="#F0F5FC" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="CanResizeWithGrip" Width="440" Height="650" MinWidth="360" MinHeight="390">
    <Border Background="#F00D1523" BorderBrush="#456773" BorderThickness="1" CornerRadius="16" Padding="20">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DUEL COMPANION" FontWeight="Bold" Foreground="{StaticResource Accent}" FontSize="12" />
                    <TextBlock Text="{Binding DeckName}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,8" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Réglages" Padding="10,6" VerticalAlignment="Top" Click="Settings_Click" Margin="8,0,0,0" />
                <Button Grid.Column="2" Content="×" ToolTip="Masquer l’overlay et suspendre" Padding="9,6" VerticalAlignment="Top" Click="Hide_Click" Margin="6,0,0,0" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,12">
                <StackPanel>
                    <StackPanel Visibility="{Binding SearchVisibility}">
                    <TextBlock Text="CARTES IDENTIFIÉES" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Hand}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="#24354A" CornerRadius="6" Padding="9,5" Margin="0,0,6,6">
                                <TextBlock FontSize="12" MaxWidth="340"><Run Text="{Binding Name}" /><Run Text="  " /><Run Foreground="#72E3C2" Text="{Binding Confidence}" /></TextBlock>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="COMBOS COMPATIBLES" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,12,0,5" />
                    <ListBox ItemsSource="{Binding Recommendations}" SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}" MaxHeight="110">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Combo.Title}" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    </StackPanel>
                    <Border Background="#162A32" CornerRadius="10" Padding="16" Margin="0,14,0,0" BorderBrush="#37625E" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding StepLabel}" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="{Binding ComboTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,10" />
                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Foreground="{StaticResource Accent}" Background="#28434A" Margin="0,0,0,14" />
                            <ItemsControl ItemsSource="{Binding StepLines}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <StackPanel>
                                        <Border Background="#203C43" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                            <Border.Style><Style TargetType="Border"><Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBranch}" Value="True"><Setter Property="BorderBrush" Value="#E3C995" /><Setter Property="BorderThickness" Value="1" /></DataTrigger>
                                            </Style.Triggers></Style></Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Badge}" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CardName}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Detail}" Foreground="#D0DFED" FontSize="13" LineHeight="20" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding Connector}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="11" Margin="0,0,0,6">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                <DataTrigger Binding="{Binding Connector}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding NextStep}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding Confidence}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Prerequisites}" Foreground="#E3C995" FontSize="12" Margin="0,12,0,0" />
                    <Expander Header="Notes de l’auteur" Foreground="#D0DFED" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Notes}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </Expander>
                    <Button Content="{Binding Attribution}" Click="Source_Click" Margin="0,10,0,0" Padding="8,6" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2">
                <StackPanel Visibility="{Binding GuideVisibility}" Margin="0,0,0,10">
                    <CheckBox Content="Avancer automatiquement sur indice visuel" IsChecked="{Binding AutoAdvance}" />
                    <TextBlock Text="{Binding ExpectedOutcome}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding GuideStatus}" Foreground="#E3C995" FontSize="12" Margin="0,5,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding GuideMode}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button Content="←" Click="Previous_Click" AutomationProperties.Name="Étape précédente" />
                    <Button Grid.Column="1" Content="{Binding FollowLabel}" Click="Follow_Click" Padding="8,9" />
                    <Button Grid.Column="2" Content="→" Click="Next_Click" AutomationProperties.Name="Étape suivante" Margin="0" />
                </Grid>
                <TextBlock x:Name="InteractionHint" Text="Passif · Ctrl+F1 pour interagir" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
